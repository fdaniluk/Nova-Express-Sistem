PORT=3000
NODE_ENV=development
# Ruta opcional de la base SQLite (por defecto: database/nova.db en la raíz del repo)
# DB_PATH=../database/nova.db
# ── UPS ────────────────────────────────────────────────────────────────────
# Credenciales de la app "Nova Express Tracking" de developer.ups.com (semáforo de
# tracking y módulo Guías). Nunca por chat: se pegan acá desde el portal.
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# Host del tracking (producción). El módulo Guías NO usa este: usa UPS_SHIPPING_ENTORNO.
# UPS_API_BASE=https://onlinetools.ups.com

# ── Módulo Guías (GUIAS-UPS.md §7) ─────────────────────────────────────────
# test = wwwcie.ups.com, guías de PRUEBA sin cargos (default) · prod = guías reales.
# UPS_SHIPPING_ENTORNO=test
# Cuenta que paga el flete (y los impuestos con DDP).
# UPS_CUENTA_EXPO=327W09
# Remitente en la guía (Shipper): los datos de Nova. Sin estos cuatro no se emite.
# UPS_SHIPPER_NOMBRE=NOVA EXPRESS
# UPS_SHIPPER_ATENCION=Administracion
# UPS_SHIPPER_TELEFONO=
# UPS_SHIPPER_DIRECCION=
# UPS_SHIPPER_CIUDAD=
# UPS_SHIPPER_CP=
# UPS_SHIPPER_PROVINCIA=B
